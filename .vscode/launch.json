{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/app"
    },
    {
      "name": "Debug current file",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${file}"
    },
    {
      "name": "Debug test with race",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "buildFlags": "-race"
    }
  ]
}
